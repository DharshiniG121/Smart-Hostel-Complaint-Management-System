<%- include('../partials/head') %>
<%- include('../partials/flash') %>
<% const pageTitle = 'Complaint Details'; const pageSubtitle = complaint.complaint_id; %>

<div class="app-shell">
    <%- include('../partials/student-sidebar') %>
    <div class="main-content">
        <%- include('../partials/topbar', { pageTitle, pageSubtitle }) %>
        <div class="page-content">
            <%
            const statusClass = {'Pending':'badge-pending','In Progress':'badge-progress','Resolved':'badge-resolved','Rejected':'badge-rejected'}[complaint.status] || 'badge-gray';
            const prioClass = {'Low':'badge-low','Medium':'badge-medium','High':'badge-high','Critical':'badge-critical'}[complaint.priority] || 'badge-gray';
            %>

            <div style="max-width: 800px; margin: 0 auto;">
                <!-- Header -->
                <div class="card" style="margin-bottom: 16px;">
                    <div class="card-header">
                        <div>
                            <div style="font-size:0.75rem; color:var(--gray); font-family:monospace; margin-bottom:4px;"><%= complaint.complaint_id %></div>
                            <h3 style="font-size:1.05rem;"><%= complaint.title %></h3>
                        </div>
                        <div class="d-flex gap-2 align-center" style="flex-wrap:wrap;">
                            <span class="badge <%= statusClass %>"><%= complaint.status %></span>
                            <span class="badge <%= prioClass %>"><%= complaint.priority %></span>
                        </div>
                    </div>
                    <div class="info-grid">
                        <div class="info-row">
                            <span class="info-label">Category</span>
                            <span class="info-value">📂 <%= complaint.category %></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Priority</span>
                            <span class="info-value"><%= complaint.priority %></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Hostel Block</span>
                            <span class="info-value">🏨 <%= complaint.hostel_block %></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Room Number</span>
                            <span class="info-value"><%= complaint.room_number %></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Submitted On</span>
                            <span class="info-value">🕒 <%= new Date(complaint.created_at).toLocaleString('en-IN') %></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Last Updated</span>
                            <span class="info-value">🔄 <%= new Date(complaint.updated_at).toLocaleString('en-IN') %></span>
                        </div>
                        <% if (complaint.resolved_at) { %>
                        <div class="info-row">
                            <span class="info-label">Resolved On</span>
                            <span class="info-value" style="color:var(--success);">✅ <%= new Date(complaint.resolved_at).toLocaleString('en-IN') %></span>
                        </div>
                        <div class="info-row"></div>
                        <% } %>
                    </div>
                    <div class="card-body" style="border-top: 1px solid var(--gray-border);">
                        <div style="font-size:0.78rem; font-weight:600; color:var(--gray); text-transform:uppercase; letter-spacing:0.05em; margin-bottom:8px;">Description</div>
                        <p style="color:var(--dark); font-size:0.88rem; line-height:1.7; white-space:pre-wrap;"><%= complaint.description %></p>
                    </div>

                    <% if (complaint.admin_remarks) { %>
                    <div class="card-body" style="border-top: 1px solid var(--gray-border); background: var(--info-light);">
                        <div style="font-size:0.78rem; font-weight:600; color:var(--info); text-transform:uppercase; letter-spacing:0.05em; margin-bottom:8px;">💬 Admin Remarks</div>
                        <p style="color:var(--dark); font-size:0.88rem; line-height:1.7;"><%= complaint.admin_remarks %></p>
                    </div>
                    <% } %>
                </div>

                <!-- Status Timeline -->
                <div class="card" style="margin-bottom: 16px;">
                    <div class="card-header"><h3>📜 Status History</h3></div>
                    <div class="card-body">
                        <% if (history.length === 0) { %>
                        <p class="text-muted text-center">No status changes recorded.</p>
                        <% } else { %>
                        <div class="timeline">
                            <% history.forEach(h => {
                                const dotClass = {'Pending':'pending','In Progress':'progress','Resolved':'resolved','Rejected':'rejected'}[h.new_status] || '';
                                const icon = {'Pending':'⏳','In Progress':'🔄','Resolved':'✅','Rejected':'❌'}[h.new_status] || '📌';
                            %>
                            <div class="timeline-item">
                                <div class="timeline-dot <%= dotClass %>"><%= icon %></div>
                                <div class="timeline-content">
                                    <div class="timeline-title">
                                        Status changed to <strong><%= h.new_status %></strong>
                                        <% if (h.old_status) { %><span style="color:var(--gray);font-weight:400;"> (from <%= h.old_status %>)</span><% } %>
                                    </div>
                                    <div class="timeline-time">
                                        By <%= h.changed_by_name || 'System' %> (<%=h.changed_by_type%>) &bull;
                                        <%= new Date(h.created_at).toLocaleString('en-IN') %>
                                    </div>
                                    <% if (h.remarks) { %>
                                    <div class="timeline-desc">📝 <%= h.remarks %></div>
                                    <% } %>
                                </div>
                            </div>
                            <% }) %>
                        </div>
                        <% } %>
                    </div>
                </div>

                <!-- Actions -->
                <div class="d-flex gap-3">
                    <a href="/student/complaints" class="btn btn-outline-gray">← Back to List</a>
                    <% if (complaint.status === 'Pending') { %>
                    <form action="/student/complaints/<%= complaint.id %>/delete" method="POST"
                          class="delete-form" data-confirm="Are you sure you want to delete this pending complaint?">
                        <button type="submit" class="btn btn-danger">🗑️ Delete Complaint</button>
                    </form>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
