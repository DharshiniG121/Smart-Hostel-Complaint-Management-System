<%- include('../partials/head') %>
<%- include('../partials/flash') %>
<% const pageTitle = 'Student Management'; const pageSubtitle = total + ' student(s) registered'; const isAdmin = true; %>

<div class="app-shell">
    <%- include('../partials/admin-sidebar') %>
    <div class="main-content">
        <%- include('../partials/topbar', { pageTitle, pageSubtitle, isAdmin }) %>
        <div class="page-content">

            <!-- Search Bar -->
            <form method="GET" action="/admin/students">
                <div class="filter-bar">
                    <input type="text" name="search" id="searchInput" class="form-control search-input"
                           placeholder="🔍 Search by name, register no, email..." value="<%= search %>">
                    <button type="submit" class="btn btn-primary">Search</button>
                    <a href="/admin/students" class="btn btn-outline-gray">Reset</a>
                </div>
            </form>

            <div class="card">
                <% if (students.length === 0) { %>
                <div class="empty-state">
                    <div class="empty-icon">👥</div>
                    <h3>No Students Found</h3>
                    <p>
                        <% if (search) { %>
                        No students match "<strong><%= search %></strong>". Try a different search term.
                        <% } else { %>
                        No students have registered yet.
                        <% } %>
                    </p>
                </div>
                <% } else { %>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>#</th>
                                <th data-sort>Name</th>
                                <th data-sort>Register No.</th>
                                <th data-sort>Department</th>
                                <th>Year</th>
                                <th>Block / Room</th>
                                <th>Phone</th>
                                <th>Complaints</th>
                                <th>Joined</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% students.forEach((s, idx) => { %>
                            <tr>
                                <td style="color:var(--gray); font-size:0.78rem;"><%= (currentPage-1)*10 + idx + 1 %></td>
                                <td>
                                    <div class="d-flex align-center gap-2">
                                        <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#2563eb,#0891b2);display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:0.8rem;flex-shrink:0;">
                                            <%= s.full_name.charAt(0).toUpperCase() %>
                                        </div>
                                        <div>
                                            <div style="font-weight:500; font-size:0.85rem;"><%= s.full_name %></div>
                                            <div style="font-size:0.72rem; color:var(--gray);"><%= s.email %></div>
                                        </div>
                                    </div>
                                </td>
                                <td><code style="font-size:0.78rem; color:var(--primary);"><%= s.register_number %></code></td>
                                <td style="font-size:0.82rem;"><%= s.department %></td>
                                <td style="font-size:0.82rem; text-align:center;">
                                    <span class="badge badge-blue">Yr <%= s.year_of_study %></span>
                                </td>
                                <td style="font-size:0.82rem;"><%= s.hostel_block %><br><span style="color:var(--gray); font-size:0.75rem;">Rm <%= s.room_number %></span></td>
                                <td style="font-size:0.82rem;"><%= s.phone %></td>
                                <td>
                                    <div style="display:flex; gap:4px; flex-wrap:wrap;">
                                        <span title="Total" class="badge badge-blue" style="font-size:0.7rem;"><%= s.total_complaints || 0 %> total</span>
                                        <% if (s.pending_complaints > 0) { %>
                                        <span title="Pending" class="badge badge-pending" style="font-size:0.7rem;"><%= s.pending_complaints %> pending</span>
                                        <% } %>
                                        <% if (s.resolved_complaints > 0) { %>
                                        <span title="Resolved" class="badge badge-resolved" style="font-size:0.7rem;"><%= s.resolved_complaints %> resolved</span>
                                        <% } %>
                                    </div>
                                </td>
                                <td style="font-size:0.78rem; color:var(--gray); white-space:nowrap;">
                                    <%= new Date(s.created_at).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %>
                                </td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a href="/admin/students/<%= s.id %>" class="btn btn-outline btn-sm" title="View Details">👁</a>
                                        <form action="/admin/students/<%= s.id %>/delete" method="POST"
                                              class="delete-form"
                                              data-confirm="Remove student '<%= s.full_name %>'? Their complaints will also be removed.">
                                            <button type="submit" class="btn btn-danger btn-sm" title="Remove Student">🗑</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <% if (totalPages > 1) { %>
                <div class="card-footer">
                    <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px;">
                        <div class="page-info">Page <%= currentPage %> of <%= totalPages %> (<%= total %> total students)</div>
                        <div class="pagination">
                            <% if (currentPage > 1) { %>
                            <a href="?page=<%= currentPage-1 %>&search=<%= search %>" class="page-btn">‹</a>
                            <% } %>
                            <% for(let i = Math.max(1,currentPage-2); i <= Math.min(totalPages,currentPage+2); i++) { %>
                            <a href="?page=<%= i %>&search=<%= search %>"
                               class="page-btn <%= i===currentPage?'active':'' %>"><%= i %></a>
                            <% } %>
                            <% if (currentPage < totalPages) { %>
                            <a href="?page=<%= currentPage+1 %>&search=<%= search %>" class="page-btn">›</a>
                            <% } %>
                        </div>
                    </div>
                </div>
                <% } %>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
